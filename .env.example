# cp .env.example .env して値を入れる。.env はコミットしない(.gitignore 済み)。

# Discord の Bot トークン(必須)
DISCORD_TOKEN=

# 録音と議事録を置くホスト側のディレクトリ。uid 1000 のユーザーが書ける必要がある。
DATA_DIR=./data
# 発言の区切りとみなす無音の長さ(ミリ秒)
SILENCE_DURATION_MS=1000
# ボイスチャンネルから全員が抜けてから自動で退出するまでの秒数(0 なら自動では退出しない)
AUTO_LEAVE_DELAY_SECONDS=60
# 録音(音声ファイル)を残す日数(0 なら消さない)。議事録(CSV・HTML・Markdown)は残す。
RECORDING_RETENTION_DAYS=30
# 音声接続(DAVE を含む)のデバッグログを出す。録音がうまくいかないときに true にする
VOICE_DEBUG=false

# recognizer のビルド元。既定は GitHub の master。手元の clone を使うときはそのディレクトリを書く
#RECOGNIZER_CONTEXT=../discord-proceedings-bot-recognizer

# 文字起こしのモデル(Hugging Face の CTranslate2 形式の Whisper モデル)
WHISPER_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster
# モデルのリビジョンを固定する。WHISPER_MODEL を変えたら、そのモデルのコミットにするか空にする。
WHISPER_MODEL_REVISION=f44edd35eaeb2274e85ac7b31fb2c6f59ff1c4bc
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=12
WHISPER_LANGUAGE=ja
WHISPER_BEAM_SIZE=5
WHISPER_CHUNK_LENGTH=15
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false

# 議事録に書く時刻のタイムゾーン
PROCEEDINGS_TIMEZONE=Asia/Tokyo
