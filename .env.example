# cp .env.example .env して値を入れる。.env はコミットしない(.gitignore 済み)。

# Discord の Bot トークン(必須)
DISCORD_TOKEN=

# 録音と議事録を置くホスト側のディレクトリ。uid 1000 のユーザーが書ける必要がある。
DATA_DIR=./data
# 発言の区切りとみなす無音の長さ(ミリ秒)
SILENCE_DURATION_MS=1000
# ボイスチャンネルから全員が抜けてから自動で退出するまでの秒数(0 なら自動では退出しない)
AUTO_LEAVE_DELAY_SECONDS=60
# 録音(音声ファイル)を残す日数(0 なら消さない)。議事録(CSV・HTML・Markdown)は残す。
RECORDING_RETENTION_DAYS=30
# 音声接続(DAVE を含む)のデバッグログを出す。録音がうまくいかないときに true にする
VOICE_DEBUG=false

# recognizer のビルド元。既定は GitHub の master。手元の clone を使うときはそのディレクトリを書く
#RECOGNIZER_CONTEXT=../discord-proceedings-bot-recognizer

# 文字起こしのモデル(Hugging Face の CTranslate2 形式の Whisper モデル)
WHISPER_MODEL=kotoba-tech/kotoba-whisper-v2.0-faster
# モデルのリビジョンを固定する。WHISPER_MODEL を変えたら、そのモデルのコミットにするか空にする。
WHISPER_MODEL_REVISION=f44edd35eaeb2274e85ac7b31fb2c6f59ff1c4bc
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=12
WHISPER_LANGUAGE=ja
WHISPER_BEAM_SIZE=5
WHISPER_CHUNK_LENGTH=15
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# 無音を VAD で取り除いてから文字起こしする。false にすると、無音から言っていない文字列が出ることがある
WHISPER_VAD_FILTER=true

# 議事録に書く時刻のタイムゾーン。/gijiroku report の期間の解釈にも使う
PROCEEDINGS_TIMEZONE=Asia/Tokyo

# --- 議事録ページの生成(/gijiroku report と自動生成) ---
# report-worker を動かすときは report にする
#COMPOSE_PROFILES=report
# 使う LLM の CLI。off / claude / codex / opencode
REPORT_AGENT=off
# モデルと effort。空なら CLI の既定値
#REPORT_AGENT_MODEL=claude-sonnet-5-5
#REPORT_AGENT_EFFORT=medium
# LLM の認証情報(使う CLI の分だけ)
# CLAUDE_CODE_OAUTH_TOKEN は claude setup-token で発行する
#CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
# CLI を包むサンドボックス。srt / none
#REPORT_AGENT_SANDBOX=srt
# LLM の API のほかに接続を許すドメイン(カンマ区切り。opencode で別のプロバイダーを使うときなど)
#REPORT_AGENT_ALLOWED_DOMAINS=
# 同時に動かす LLM の数
#REPORT_AGENT_CONCURRENCY=3
# LLM のタスク 1 件の時間の上限(秒)
#REPORT_AGENT_TASK_TIMEOUT_SECONDS=900
# LLM のタスク 1 件の費用の上限(ドル)。claude のみ
#REPORT_AGENT_MAX_BUDGET_USD=
# 論文や Wikipedia などの関連資料を調べるか。on / off
#REPORT_RESEARCH=on
# 調べる話題の数の上限
#REPORT_RESEARCH_MAX_TOPICS=10
# 調査で開いてよいドメイン(カンマ区切り。*.example.com の形は可、*.com は不可)。空なら既定の一覧
#REPORT_RESEARCH_ALLOWED_DOMAINS=
# 最後の録音が終わってから自動で生成するまでの時間。0 なら自動では生成しない
REPORT_AUTO_DELAY_HOURS=12
# report-worker の結果を待つ時間の上限(分)
#REPORT_JOB_TIMEOUT_MINUTES=240

# 公開先。simple-static-pager のみ
#REPORT_PUBLISHER=simple-static-pager
# 公開先のリポジトリ(owner/name)とブランチ
#PAGER_REPO=anosatsuk124/simple-static-pager
#PAGER_BRANCH=html
# そのリポジトリだけに権限を絞った fine-grained PAT(Contents: read and write, Actions: read)
#PAGER_GITHUB_TOKEN=
