{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "research",
    "type": "object",
    "additionalProperties": false,
    "required": ["topic", "sources"],
    "properties": {
        "topic": { "type": "string" },
        "sources": {
            "type": "array",
            "maxItems": 4,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "url", "kind", "summary", "relevance"],
                "properties": {
                    "title": { "type": "string", "maxLength": 200 },
                    "url": { "type": "string", "pattern": "^https://" },
                    "kind": {
                        "enum": ["paper", "encyclopedia", "article", "other"]
                    },
                    "summary": { "type": "string", "maxLength": 500 },
                    "relevance": { "type": "string", "maxLength": 300 }
                }
            }
        }
    },
    "examples": [
        {
            "topic": "r1",
            "sources": [
                {
                    "title": "Kolmogorov complexity",
                    "url": "https://en.wikipedia.org/wiki/Kolmogorov_complexity",
                    "kind": "encyclopedia",
                    "summary": "文字列を出力する最短のプログラムの長さとして定義される情報量の概念を説明している。",
                    "relevance": "圧縮と情報量の関係を確かめられる。"
                }
            ]
        }
    ]
}
