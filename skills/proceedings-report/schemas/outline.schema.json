{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "outline",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "title",
        "lede",
        "key_points",
        "decisions",
        "open_questions",
        "chapters",
        "threads",
        "glossary",
        "research_topics"
    ],
    "properties": {
        "title": { "type": "string", "maxLength": 40 },
        "lede": { "type": "string", "maxLength": 500 },
        "key_points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "open_questions": {
            "type": "array",
            "items": { "$ref": "#/$defs/point" }
        },
        "chapters": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "title",
                    "start",
                    "end",
                    "summary",
                    "flow",
                    "point"
                ],
                "properties": {
                    "title": { "type": "string", "maxLength": 40 },
                    "start": { "type": "string" },
                    "end": { "type": "string" },
                    "summary": { "type": "string", "maxLength": 400 },
                    "flow": {
                        "type": "array",
                        "maxItems": 3,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["label", "text"],
                            "properties": {
                                "label": { "type": "string", "maxLength": 12 },
                                "text": { "type": "string", "maxLength": 160 }
                            }
                        }
                    },
                    "point": { "type": "string", "maxLength": 240 }
                }
            }
        },
        "threads": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["topic", "question", "positions"],
                "properties": {
                    "topic": { "type": "string", "maxLength": 60 },
                    "question": { "type": "string", "maxLength": 200 },
                    "positions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["speaker", "text", "refs"],
                            "properties": {
                                "speaker": { "type": "string" },
                                "text": { "type": "string", "maxLength": 300 },
                                "refs": { "$ref": "#/$defs/refs" }
                            }
                        }
                    }
                }
            }
        },
        "glossary": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["term", "heard", "note"],
                "properties": {
                    "term": { "type": "string" },
                    "heard": { "type": "array", "items": { "type": "string" } },
                    "note": { "type": "string", "maxLength": 200 }
                }
            }
        },
        "research_topics": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "query", "question", "chapters"],
                "properties": {
                    "id": { "type": "string" },
                    "query": { "type": "string", "maxLength": 200 },
                    "question": { "type": "string", "maxLength": 300 },
                    "chapters": {
                        "type": "array",
                        "items": { "type": "integer", "minimum": 1 }
                    }
                }
            }
        }
    },
    "$defs": {
        "refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "pattern": "^l[0-9]+$" }
        },
        "point": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "refs"],
            "properties": {
                "text": { "type": "string", "maxLength": 300 },
                "refs": { "$ref": "#/$defs/refs" }
            }
        }
    },
    "examples": [
        {
            "title": "画面共有の手順と資料の読み方",
            "lede": "Aliceが資料を画面共有して読み始める。",
            "key_points": [{ "text": "資料を共有した", "refs": ["l1"] }],
            "decisions": [],
            "open_questions": [],
            "chapters": [
                {
                    "title": "資料の共有",
                    "start": "l1",
                    "end": "l2",
                    "summary": "資料を共有する。",
                    "flow": [{ "label": "発端", "text": "共有を始める。" }],
                    "point": "共有の方法を決める。"
                }
            ],
            "threads": [],
            "glossary": [
                {
                    "term": "画面共有",
                    "heard": ["画面距離"],
                    "note": "Discordの機能"
                }
            ],
            "research_topics": [
                {
                    "id": "r1",
                    "query": "コルモゴロフ複雑性",
                    "question": "圧縮との関係",
                    "chapters": [1]
                }
            ]
        }
    ]
}
